{
  "name": "conversation-copilot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset",
    "seed": "node scripts/seed.mjs",
    "seed:reset": "node scripts/seed.mjs http://localhost:3000 --reset",
    "setup": "prisma generate && prisma db push",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "next": "^16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "prisma": "6.16.2",
    "typescript": "5.8.3"
  }
}
