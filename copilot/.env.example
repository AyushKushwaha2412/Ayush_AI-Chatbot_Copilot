# ---------------------------------------------------------------------------
# Personal Conversation Copilot — environment
# Copy to .env and fill in. NOTHING here is ever sent to the browser.
# ---------------------------------------------------------------------------

DATABASE_URL="file:./dev.db"

# --- Local LLM (Ollama, OpenAI-compatible endpoint) ------------------------
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="qwen3:8b"

# --- Optional remote provider (OpenAI-compatible) --------------------------
# Prefer setting the key in the Settings UI (stored server-side in SQLite).
# This env var is used as a fallback when no DB key is present.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# --- WhatsApp Cloud API ----------------------------------------------------
# Leave empty to run in SIMULATION mode (nothing leaves the machine).
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="copilot-verify-token"
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v21.0"
# "simulated" | "live"
WHATSAPP_MODE="simulated"

# --- Security --------------------------------------------------------------
# Set to a long random string to require an access code before the UI loads.
APP_ACCESS_CODE=""
